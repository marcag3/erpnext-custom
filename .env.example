# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/environment-variables.md

ERPNEXT_IMAGE=ghcr.io/marcag3/erpnext-docker:v16

# Database Configuration
DB_PASSWORD=123

# Admin User Configuration (for first-time setup)
ADMIN_PASSWORD=admin

# Host user ID the containers run as (group is always 0, like upstream frappe_docker).
# Must own the bind-mounted ./sites folder. Run 'id -u' on your host to get it.
PUID=1000
