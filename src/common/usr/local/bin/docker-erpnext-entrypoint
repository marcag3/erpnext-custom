#!/bin/sh
# Runs the /etc/entrypoint.d scripts, then the container command.
# Runs as the unprivileged frappe user; files stay group-accessible (gid 0).

set -e

umask 0002

for script in /etc/entrypoint.d/[0-9]*-*.sh; do
    if [ -f "$script" ] && [ -x "$script" ]; then
        echo "Running entrypoint script: $script"
        . "$script"
    fi
done

exec "$@"
